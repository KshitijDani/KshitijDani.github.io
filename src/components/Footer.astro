---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-grid">
    <div>
      <p class="footer-callout">Email me at: <a class="footer-callout" href={`mailto:${profile.email}`}>{profile.email}</a></p>
    </div>
    <div class="footer-links" aria-label="Social links">
      <a href={profile.github} rel="me">GitHub</a>
      <a href={profile.linkedin} rel="me">LinkedIn</a>
      <a href="/resume/">Résumé</a>
    </div>
    <p class="footer-meta">© {year} Kshitij Dani · A working notebook from Seattle.</p>
  </div>
</footer>
