---
import type { CollectionEntry } from 'astro:content';
const { project } = Astro.props as { project: CollectionEntry<'work'> };
---

<article class="project-card">
  <a class="project-card-link" href={`/work/${project.id}/`} aria-label={`Read case study: ${project.data.title}`}>
    <h3>{project.data.title}</h3>
    <p class="project-field">{project.data.kicker}</p>
    <p class="project-description">{project.data.description}</p>
  </a>
</article>
