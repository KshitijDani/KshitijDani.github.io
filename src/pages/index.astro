---
import { getCollection } from 'astro:content';
import { faMicrosoft } from '@fortawesome/free-brands-svg-icons';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { awards, experiences, profile } from '../data/profile';

const projects = (await getCollection('work'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const microsoftIcon = {
  width: faMicrosoft.icon[0],
  height: faMicrosoft.icon[1],
  path: faMicrosoft.icon[4] as string,
};
const schema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateModified: '2026-07-13',
  mainEntity: {
    '@type': 'Person',
    '@id': 'https://kshitijdani.github.io/#kshitij-dani',
    name: profile.name,
    givenName: profile.givenName,
    url: 'https://kshitijdani.github.io',
    image: 'https://kshitijdani.github.io/images/kshitij-dani.jpg',
    jobTitle: 'Software Engineer and Graduate Researcher',
    description: profile.shortBio,
    homeLocation: { '@type': 'Place', name: profile.location },
    alumniOf: [
      { '@type': 'CollegeOrUniversity', name: 'University of Washington' },
      { '@type': 'CollegeOrUniversity', name: 'BITS Pilani' },
    ],
    worksFor: { '@type': 'Organization', name: 'University of Washington eScience Institute' },
    knowsAbout: [
      'AI agents',
      'Large language models',
      'Distributed systems',
      'Backend engineering',
      'Cloud computing',
      'Application security',
      'LLM evaluation',
    ],
    sameAs: [profile.github, profile.linkedin],
  },
};
---

<BaseLayout schema={schema}>
  <section class="hero">
    <div class="shell home-grid">
      <aside class="identity-rail">
        <figure class="hero-photo-wrap">
          <img class="hero-photo" src="/images/kshitij-dani.jpg" width="460" height="460" alt="Kshitij Dani standing in front of cherry blossoms" />
          <figcaption>Seattle, Washington</figcaption>
        </figure>
        <p class="identity-current">Graduate researcher at UW eScience Institute · SSEC</p>
        <div class="identity-links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.github}>GitHub</a>
          <a href={profile.linkedin}>LinkedIn</a>
        </div>
      </aside>

      <div class="home-main">
        <div class="hero-copy">
          <h1 class="display-title">Software Engineer and AI Systems Researcher.</h1>
          <p class="hero-intro">
            I'm a graduate student at the University of Washington in Seattle. Before returning to school, I spent five years building enterprise employee experiences at Microsoft.
          </p>
          <p>
            My work today spans AI agents, evaluation systems, and software engineering workflows. My goal is to help people and engineering teams build better software by using AI effectively while maintaining reliability, security, and a great developer experience. I'm particularly interested in the backend, distributed systems, and cloud infrastructure that make these systems practical at scale.
          </p>
          <div class="hero-actions">
            <a class="text-action" href="/resume/">Résumé <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="selected-work" class="projects-section scroll-reveal">
    <div class="shell section-stack">
      <div class="section-heading-row">
        <h2 class="section-title">Selected Work</h2>
        <a class="text-action" href="/work/">All projects <span aria-hidden="true">→</span></a>
      </div>
      <div class="projects-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="experience-preview">
    <div class="shell section-stack">
      <div class="section-heading-row">
        <h2 class="section-title">Experience</h2>
        <a class="text-action" href="/experience/">Full experience <span aria-hidden="true">→</span></a>
      </div>
      <div class="timeline-list">
        {experiences.slice(0, 4).map((experience) => (
          <article class="timeline-item">
            <a
              class="timeline-content"
              href={`/experience/#${experience.id}`}
              aria-label={`View full experience: ${experience.role} at ${experience.organization}`}
            >
              <time>{experience.period}</time>
              <h3>{experience.organization}</h3>
              {experience.team && <p class="timeline-team">{experience.team}</p>}
              <p class="timeline-role">{experience.role}</p>
              <p>{experience.summary}</p>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="awards-section">
    <div class="shell section-stack">
      <div class="section-heading-row">
        <h2 class="section-title">Awards</h2>
      </div>
      <div class="awards-grid">
        {awards.map((award) => (
          <article class="award-card">
            <div class="award-logo" aria-hidden="true">
              <svg viewBox={`0 0 ${microsoftIcon.width} ${microsoftIcon.height}`}><path d={microsoftIcon.path}></path></svg>
            </div>
            <h3>{award.title}</h3>
            <p class="award-meta">{award.organization} · {award.year}</p>
            <p class="award-detail">{award.detail}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  document.documentElement.classList.add('has-js');
  const section = document.querySelector<HTMLElement>('.scroll-reveal');
  if (section) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) {
          section.classList.add('is-visible');
          observer.disconnect();
        }
      },
      { threshold: 0.08 },
    );
    observer.observe(section);
  }
</script>
